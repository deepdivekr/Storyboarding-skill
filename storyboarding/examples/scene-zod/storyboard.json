      "import * as z from \"zod\";",
      "",
      "const Order = z.object({",
      "  item: z.string(),",
      "  qty: z.number().int().positive(),",
      "  pickup: z.iso.date(),",
      "  note: z.string().max(80).optional(),",
      "});",
      "type Order = z.infer<typeof Order>;"
    ],
