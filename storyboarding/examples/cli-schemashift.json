        },
        {
          "text": "CREATE INDEX CONCURRENTLY orders_shipped_at_idx",
          "kind": "progress",
          "done": "built"
        },
        {
          "text": "ALTER COLUMN status TYPE varchar(24)",
          "kind": "dim"
        },
        {
          "text": "counting rows before and after",
          "kind": "progress",
          "done": "1.2M = 1.2M"
        },
        {
          "text": "applied v42 in 6.8s",
          "kind": "ok"
        }
      ],
      "files": [
        {
          "path": ".snapshots/orders_0924.dump",
          "change": "+",
          "line": 0
        },
        {
          "path": "schema/orders.lock",
          "change": "~",
          "line": 6
        },
        {
          "path": "migrations/applied.log",
          "change": "~",
          "line": 6
        }
      ],
      "checks": [
        {
          "name": "backup restorable",
          "result": "pass"
        },
        {
          "name": "row count matches",
          "result": "pass",
          "note": "1.2M"
        },
        {
          "name": "index valid",
          "result": "pass"
        },
        {
          "name": "app queries replayed",
          "result": "pass",
          "note": "48/48"
        }
      ],
      "metrics": {
        "tables": 1,
        "rows": 1204,
        "lost": 0,
        "secs": 6.8
      },
      "result": "applied",
      "duration": "6.8s",
      "toast": "v42 live, 0 rows lost"
    },
    {
      "command": "schemashift apply customers --backup",
      "lines": [
        {
          "text": "backup customers -> .snapshots/customers_0924.dump",
          "kind": "progress",
          "done": "saved"
        },
        {
          "text": "applying 043_customers.sql",
          "kind": "head"
