{
  "template": "cli",
  "meta": {
    "name": "schemashift",
    "tagline": [
      "Database migrations that plan first, back up before they touch data,",
      "and prove the row counts afterwards."
    ],
    "headerRight": "postgres · mysql · sqlite",
    "counterLabel": "session",
    "counterStart": 57,
    "shellTitle": "~/shop-api  zsh",
    "surfaceLabel": "terminal",
    "prompt": "$",
    "changesTitle": "Changes",
    "checksTitle": "Checks",
    "metricsTitle": "This session",
    "metrics": [
      {
        "key": "tables",
        "label": "tables touched",
        "sum": true
      },
      {
        "key": "rows",
        "label": "rows verified",
        "unit": "k",
        "sum": true,
        "decimals": 0
      },
      {
        "key": "lost",
        "label": "rows lost",
        "sum": true
      },
      {
        "key": "secs",
        "label": "wall time",
        "unit": "s",
        "decimals": 1
      }
    ],
    "footerLeft": "github.com/example/schemashift",
    "footerRight": "example storyboard  /  simulated",
    "runSeconds": 8
  },
  "episodes": [
    {
      "command": "schemashift plan orders --to v42",
      "lines": [
        {
          "text": "reading schema from shop_db",
          "kind": "dim"
        },
        {
          "text": "plan: orders v41 -> v42",
          "kind": "head"
        },
        {
          "text": "+ column shipped_at timestamptz"
        },
        {
          "text": "+ index orders_shipped_at_idx"
        },
        {
          "text": "~ column status: varchar(16) -> varchar(24)"
        },
        {
          "text": "estimated lock: 0.4s, rows scanned: 1.2M"
        },
        {
          "text": "plan written to migrations/042_orders.sql",
          "kind": "ok"
        }
      ],
      "files": [
        {
          "path": "migrations/042_orders.sql",
          "change": "+",
          "line": 6
