        {
          "path": "schema/orders.lock",
          "change": "~",
          "line": 6
        }
      ],
      "checks": [
        {
          "name": "plan is reversible",
          "result": "pass"
        },
        {
          "name": "no destructive ops",
          "result": "pass"
        },
        {
          "name": "lock under 1s",
          "result": "pass",
          "note": "0.4s"
        }
      ],
      "metrics": {
        "tables": 1,
        "rows": 0,
        "lost": 0,
